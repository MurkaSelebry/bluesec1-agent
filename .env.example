# BlueSec1: локальная конфигурация с тестовыми ключами пользователя.
# Из корня репозитория: cp .env.example .env
# Запуск агента (создаёт run и начинает расследования):
# uv run --env-file .env bluesec1-agent

# --- BlueSec runtime: отдельный ключ участника и адрес gRPC без https:// ---
SCENARIO_RUNTIME_ENDPOINT=bluesec.team:443
SCENARIO_RUNTIME_TOKEN=replace-with-your-key
SCENARIO_RUNTIME_VERIFY_TLS=true
# Не задавайте пустую арену. По умолчанию сервер выбирает открытую арену.
# Для конкретной арены раскомментируйте и укажите её имя:
# SCENARIO_RUNTIME_ARENA=practice

# Передаётся самому gRPC при запуске с --env-file; полезно на macOS.
GRPC_DNS_RESOLVER=native
# Имя агента отображается в интерфейсе BlueSec; label — подпись запуска.
AGENT_NAME=bluesec1-agent
REMOTE_RUN_LABEL=bluesec1-agent

# --- LLM: OpenAI-compatible Chat Completions API ---
# Нужен корень /v1, без суффикса /chat/completions.
# Код читает LLM_BASE_URL и LLM_API_KEY; BASE_API и LLM_KEY не используются.
LLM_BASE_URL=https://fluxapi.shop/v1
LLM_API_KEY=replace-with-your-key
# Стартовая модель для проверки интеграции; качество расследований ещё не оценено.
LLM_DEFAULT_MODEL=gpt-6-luna

# Модели из списка пользователя (меняйте только LLM_DEFAULT_MODEL):
# gpt-5.5, gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol
# deepseek-v4-flash, deepseek-v4-pro
# Проверка 2026-10-10: обе DeepSeek вернули HTTP 400 / FluxAPI error 2000.
# Их доступность через этот gateway пока не подтверждена.
# claude-opus-4.6, claude-opus-4.7, claude-opus-4.8, claude-opus-5
# claude-sonnet-4.6, claude-sonnet-5
# gpt-6-astra, gpt-6-luna, gpt-6-sol, claude-opus-5-5, gpt-6.1-sol

# Таймаут одного HTTP-запроса к LLM, секунды (> 0).
LLM_TIMEOUT_SECONDS=120
# Лимит токенов ответа, включая reasoning, если провайдер его учитывает (> 0).
LLM_MAX_COMPLETION_TOKENS=16384
# Число попыток получить корректный JSON на шаг (1..5).
# Это не количество повторов при HTTP-ошибках или недоступности провайдера.
LLM_MAX_STEP_RETRIES=3

# Лимит шагов агента на одну задачу (1..100).
BLUESEC_AGENT_MAX_STEPS=100
